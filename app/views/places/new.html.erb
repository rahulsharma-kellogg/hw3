<h1>New Place</h1>
<h2> Please input the name of the new city you have traveled to!</h2>

<form action="/places" method="post">
  <% if @place.errors.any? %>
    <p> An error has occured - likely due to a duplicate entry. Check if you have already added this location before and try again.<p>
  <% end %>

  <p>
    <label for="name">Location Name</label>
    <input type="text" name="name">
  </p>

  <button>Create Post</button>

<p>
  <a href="/places">Return to Travel Log</a>
</p>