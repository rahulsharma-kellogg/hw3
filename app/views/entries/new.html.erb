<h1>New Entry</h1>
<h2>Please input a memory you have had in <%= @place["name"] %>!</h2>

<form action="/entries?place_id=<%= @place['id'] %>" method="post">
  <% if @entry.errors.any? %>
    <p>Please correct the errors and try again.</p>
  <% end %>

  <p>
    <label for="occurred_on">Date event occurred</label><br>
    <input type="date" id="occurred_on" name="occurred_on">
  </p>

  <p>
    <label for="title">Event title</label><br>
    <input type="text" id="title" name="title">
  </p>

  <p>
    <label for="description">Description</label><br>
    <textarea id="description" name="description"></textarea>
  </p>

  <p>
    <button>Create Entry</button>
  </p>
</form>

<p>
  <a href="/places/<%= @place['id'] %>">Return to <%= @place["name"] %></a>
</p>
