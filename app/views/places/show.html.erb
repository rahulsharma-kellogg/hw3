<h1><%= @place["name"] %></h1>

<div class="row">
  <% for entry in @entries %>
    <div class="col-3">
      <h3><%= entry["title"] %></h3>
      <h4><%= entry["occurred_on"] %></h4>
      <p><%= entry["description"] %></p>
    </div>
  <% end %>
</div>

<p>
  <a href="/places/<%= @place['id'] %>/new">Add a new event</a>
</p>

<p>
  <a href="/places">Return to Travel Log</a>
</p>
